@using MVC.Core.Editors
@using MVC.Domain
@model IEnumerable<MVC.Facade.MedicalRecordView>

@{
	ViewData["Title"] = "List of Medical Records";
	Layout = "_Index";

	var propsToShow = new[] {
		nameof(MVC.Facade.MedicalRecordView.PatientFullName),
		nameof(MVC.Facade.MedicalRecordView.RecordNr),
		nameof(MVC.Facade.MedicalRecordView.DiagnosedOn) };
}

@Html.TableFor(Model, propsToShow)