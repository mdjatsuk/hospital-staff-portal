@using MVC.Core.Editors
@using MVC.Domain
@model IEnumerable<MVC.Facade.AppointmentView>

@{
	ViewData["Title"] = "List of Appointments";
	Layout = "_Index";
	var propsToShow = new[] {
		nameof(MVC.Facade.AppointmentView.DoctorId),
		nameof(MVC.Facade.AppointmentView.PatientId),
		nameof(MVC.Facade.AppointmentView.Date),
		nameof(MVC.Facade.AppointmentView.Room),
		nameof(MVC.Facade.AppointmentView.AppointmentFee) };
}

@Html.TableFor(Model,propsToShow)