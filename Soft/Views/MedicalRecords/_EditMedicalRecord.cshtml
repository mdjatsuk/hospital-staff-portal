@using MVC.Core
@using MVC.Core.Editors
@using MVC.Domain
@model MVC.Facade.MedicalRecordView

@{
    var description = await Services.Get<IDiagnosesRepo>()?.GetAsync()! ?? [];
    var patients = await Services.Get<IPatientsRepo>()?.GetAsync()! ?? [];
    description = description.OrderBy(m => m.Description).ToList();
    patients = patients.OrderBy(p => p.FullName).ToList();
    var selectDescription = new SelectList(description, "Id", "Description", Model.DescriptionId);
    var selectPatients = new SelectList(patients, "Id", "FullName", Model.PatientId);
}

@Html.SelectFor(x => x.PatientId, selectPatients)
@Html.InputForEnum(x => x.Diagnosis)
@Html.SelectFor(x => x.DescriptionId, selectDescription)
@Html.InputFor(x => x.DiagnosedOn)
