@model MVC_Project.Domain.Entity

@{
	ViewData["Title"] = "Delete";
	var title = MVC_Project.Core.TypeHelper.DisplayName(Model, "Index");
	Layout = "_Layout";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
	<h4>@title</h4>
	<hr />
	<dl class="row">
		@RenderBody()
	</dl>

	<form asp-action="Delete">
		<input type="hidden" asp-for="@ViewData["ItemId"]" />
		<input type="submit" value="Delete" class="btn btn-danger" /> |
		<a asp-action="Index" class="btn btn-secondary">Back to List</a>
	</form>
</div>

