@{
    ViewData["Title"] = "Staff Portal";
}

<div class="text-center">
    <h1 class="display-4" style="color: #2c3e50; font-family: 'Poppins', sans-serif;">Hospital Info System</h1>
    <p style="color: #7f8c8d; font-family: 'Roboto', sans-serif;">Streamline your workflow and manage hospital operations efficiently.</p>
</div>

<div class="row mt-5">
    @foreach (var card in new[]
    {
    new { Title = "Manage Appointments", Text = "Schedule, view, or update appointments for patients with ease.", Link = "/Appointments", ButtonText = "Manage Appointments" },
    new { Title = "Our Doctors", Text = "View and collaborate with your fellow medical professionals.", Link = "/Doctors", ButtonText = "View Doctors" },
    new { Title = "Patient Records", Text = "Access and manage patient records securely and efficiently.", Link = "/Patients", ButtonText = "View Records" },
    new { Title = "Diagnoses", Text = "Review and manage diagnoses and treatment plans with precision.", Link = "/Diagnoses", ButtonText = "View Diagnoses" },
    new { Title = "Medical Records", Text = "Review and manage medical records", Link = "/MedicalRecords", ButtonText = "View Medical Records" }
    })
    {
        <div class="col-md-3">
            <div class="card shadow-sm" style="border-color: #ecf0f1; border-radius: 15px;">
                <div class="card-body">
                    <h5 class="card-title" style="color: #2c3e50; font-family: 'Roboto', sans-serif;">@card.Title</h5>
                    <p class="card-text" style="color: #95a5a6; font-family: 'Roboto', sans-serif;">@card.Text</p>
                    <a href="@card.Link" class="btn btn-outline-primary" style="color: #007bff; border-color: #007bff; border-radius: 30px; padding: 10px 20px;">@card.ButtonText</a>
                </div>
            </div>
        </div>
    }
</div>
