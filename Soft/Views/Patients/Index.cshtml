@using MVC.Core
@using MVC.Core.Editors
@using MVC.Domain
@using MVC.Facade
@model IEnumerable<PatientView>

@{
	ViewData["Title"] = "List of Patients";
	Layout = "_Index";

	async Task<IEnumerable<DiagnosisView>> relatedDiagnoses()
	{
		var id = ViewBag.SelectedId;
		var patient = await Services.Get<IPatientsRepo>()?.GetAsync(id) as Patient;
		if (patient != null) await patient.LoadLazy();
		var patientDiagnoses = patient?.RecordNr?.Where(x => x is not null);
		return patientDiagnoses?.Select(x => new DiagnosisViewFactory().CreateView(x!.data)) ?? [];
	}
}

@Html.TableFor(Model, true)


@if (ViewBag.SelectedId != null)
{
	@await Html.PartialAsync("_RelatedMedicines", await relatedDiagnoses())
}