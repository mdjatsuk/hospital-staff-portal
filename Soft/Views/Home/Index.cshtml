@{
    ViewData["Title"] = "Staff Portal";
}

<div class="text-center">
    <h1 class="display-4" style="color: #2c3e50; font-family: 'Poppins', sans-serif;">Welcome to the Staff Portal</h1>
    <p style="color: #7f8c8d; font-family: 'Roboto', sans-serif;">Streamline your workflow and manage hospital operations efficiently.</p>
</div>

<div class="row mt-5">
    <div class="col-md-3">
        <div class="card shadow-sm" style="border-color: #ecf0f1; border-radius: 15px;">
            <div class="card-body">
                <h5 class="card-title" style="color: #2c3e50; font-family: 'Roboto', sans-serif;">Manage Appointments</h5>
                <p class="card-text" style="color: #95a5a6; font-family: 'Roboto', sans-serif;">Schedule, view, or update appointments for patients with ease.</p>
                <a href="/Appointments" class="btn btn-outline-primary" style="color: #007bff; border-color: #007bff; border-radius: 30px; padding: 10px 20px;">Manage Appointments</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="border-color: #ecf0f1; border-radius: 15px;">
            <div class="card-body">
                <h5 class="card-title" style="color: #2c3e50; font-family: 'Roboto', sans-serif;">Our Doctors</h5>
                <p class="card-text" style="color: #95a5a6; font-family: 'Roboto', sans-serif;">View and collaborate with your fellow medical professionals.</p>
                <a href="/Doctors" class="btn btn-outline-primary" style="color: #007bff; border-color: #007bff; border-radius: 30px; padding: 10px 20px;">View Doctors</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="border-color: #ecf0f1; border-radius: 15px;">
            <div class="card-body">
                <h5 class="card-title" style="color: #2c3e50; font-family: 'Roboto', sans-serif;">Patient Records</h5>
                <p class="card-text" style="color: #95a5a6; font-family: 'Roboto', sans-serif;">Access and manage patient records securely and efficiently.</p>
                <a href="/Patients" class="btn btn-outline-primary" style="color: #007bff; border-color: #007bff; border-radius: 30px; padding: 10px 20px;">View Records</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm" style="border-color: #ecf0f1; border-radius: 15px;">
            <div class="card-body">
                <h5 class="card-title" style="color: #2c3e50; font-family: 'Roboto', sans-serif;">Medical Records</h5>
                <p class="card-text" style="color: #95a5a6; font-family: 'Roboto', sans-serif;">Review and manage diagnoses and treatment plans with precision.</p>
                <a href="/MedicalRecords" class="btn btn-outline-primary" style="color: #007bff; border-color: #007bff; border-radius: 30px; padding: 10px 20px;">View Patient Diagnoses</a>
            </div>
        </div>
    </div>
</div>
